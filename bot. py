# ЗАПУСК
# =========================


def main():
    global BOT_ID, BOT_USERNAME

    if not TOKEN:
        print("Сначала задай токен:")
        print("export BOT_TOKEN='СЮДА_ТОКЕН'")
        return

    me = tg("getMe")
    if not me.get("ok"):
        print("Не удалось авторизоваться. Проверь токен.")
        return

    result = me.get("result", {})
    BOT_ID = result.get("id")
    BOT_USERNAME = result.get("username") or ""

    set_my_commands()

    print(f"Бот запущен: @{BOT_USERNAME}")
    print("Остановка: Ctrl+C")

    offset = None

    while True:
        try:
            updates = get_updates(offset)

            for update in updates:
                update_id = update.get("update_id")
                if update_id is not None:
                    offset = update_id + 1

                message = update.get("message")
                if message:
                    handle_message(message)

        except KeyboardInterrupt:
            save_db()
            print("Остановлено.")
            break

        except SystemExit:
            save_db()
            break

        except Exception as exc:
            print("Ошибка в цикле:", exc)
            time.sleep(3)


if __name__ == "__main__":
    main()
