def tg(method, **params):
    if not API:
        return {"ok": False, "description": "No token"}

    clean_params = {}
    for key, value in params.items():
        if value is not None:
            clean_params[key] = value

    try:
        r = requests.post(API + method, json=clean_params, timeout=50)
        data = r.json()

        if not data.get("ok"):
            print("Telegram API error:", data)
            if data.get("error_code") == 429:
                retry_after = data.get("parameters", {}).get("retry_after", 3)
                time.sleep(int(retry_after))

        return data

    except Exception as exc:
        print("Telegram request error:", exc)
        return {"ok": False, "description": str(exc)}


def send_message(chat_id, text, reply_to=None):
    if chat_id is None or not text:
        return
    return tg(
        "sendMessage",
        chat_id=chat_id,
        text=text[:4096],
        reply_to_message_id=reply_to
    )


def send_typing(chat_id):
    if chat_id is None:
        return
    tg("sendChatAction", chat_id=chat_id, action="typing")


def set_my_commands():
    commands = [
        {"command": "start", "description": "Старт"},
        {"command": "help", "description": "Команды"},
        {"command": "whoami", "description": "Что бот помнит о тебе"},
