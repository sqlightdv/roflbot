# ОБРАБОТКА СООБЩЕНИЙ
# =========================


def handle_message(message):
    if not message:
        return

    chat = message.get("chat", {})
    if chat.get("type") == "channel":
        return

    from_user = message.get("from") or {}
    if from_user.get("is_bot"):
        return

    text = (message.get("text") or "").strip()
    if not text:
        return

    # Команды
    if text.startswith("/"):
        first_word = text.split(maxsplit=1)[0]

        # Если команда адресована другому боту — игнорим
        if "@" in first_word:
            command_username = first_word.split("@", 1)[1].lower()
            if BOT_USERNAME and command_username != BOT_USERNAME.lower():
                return

        cmd, args = get_command(text)
        if cmd:
            handle_command(message, cmd, args)
        return

    # Обычный текст
    user = remember_message(message)
    save_db()

    if not user:
        return

    chat_id = chat.get("id")
    message_id = message.get("message_id")
    low = text.lower()

    # Пользователь может сам дать боту факт
    if low.startswith(("запомни:", "запомни,")):
        parts = text.split(maxsplit=1)
        fact = parts[1].strip() if len(parts) > 1 else ""

        if fact:
            user["facts"].append(fact[:200])
            user["facts"] = trim_list(user["facts"], 50)
            save_db()
            send_message(
                chat_id,
                pick([
                    "Записал. Потом припомню.",
                    "Принято. Теперь это можно использовать против тебя.",
                    "Ок, сохранил в рофл-блокнот."
                ]),
                reply_to=message_id
            )
        else:
            send_message(chat_id, "Формат: запомни: текст", reply_to=message_id)
        return

    # Логика ответа
    if chat.get("type") == "private":
        should_reply = True
    else:
        mentioned = bool(BOT_USERNAME and f"@{BOT_USERNAME.lower()}" in low)

        reply_to_message = message.get("reply_to_message") or {}
        replied_to_bot = (reply_to_message.get("from") or {}).get("id") == BOT_ID

        mode = DB.get("settings", {}).get("mode", "normal")
        chance = float(DB.get("settings", {}).get("reply_chance", 0.30))

        if mode == "silent":
            chance = 0.0
        elif mode == "chaos":
            chance = 0.75
        elif mode == "troll":
            chance = max(chance, 0.45)
        elif mode == "smart":
            chance = max(chance, 0.35)

        should_reply = mentioned or replied_to_bot or (random.random() < chance and can_random_reply(chat_id))

    if not should_reply:
        return

    send_typing(chat_id)
    answer = compose_reply(message, text, user)

    if answer:
        send_message(chat_id, answer, reply_to=message_id)
        save_db()


