def ask_llm(text, user):
    """
    Опциональный LLM-режим.
    Если нет LLM_API_KEY, просто возвращает None.
    """
    if not LLM_API_KEY:
        return None

    try:
        interests = ", ".join(user.get("interests", [])[-10:])
        system_prompt = (
            "Ты рофл-бот в Telegram. Отвечай на русском, коротко, смешно и слегка тролльски. "
            "Без мата, без угроз, без жёстких оскорблений. Иногда будь полезным. "
            f"Известные интересы собеседника: {interests or 'неизвестны'}."
        )

        payload = {
            "model": LLM_MODEL,
            "temperature": 0.9,
            "max_tokens": 150,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": text}
            ]
        }

        headers = {
            "Authorization": f"Bearer {LLM_API_KEY}",
            "Content-Type": "application/json"
        }

        r = requests.post(LLM_API_URL, json=payload, headers=headers, timeout=15)
        if r.status_code != 200:
            return None

        data = r.json()
        return data["choices"][0]["message"]["content"].strip()[:700]

    except Exception:
        return None


def compose_reply(message, text, user):
    low = text.lower()

    # Триггеры
    for trigger, replies in DB.get("triggers", {}).items():
        if trigger.lower() in low:
            if isinstance(replies, str):
                return replies
            if replies:
                return random.choice(replies)

    # Быстрые ответы
    if any(x in low for x in ("кто ты", "ты кто", "что ты", "ты бот")):
        return pick([
            "Я бот. Но с чувством собственного превосходства.",
            "Твой личный генератор рофлов и лёгкого давления.",
            "Я — тот, кто читает чат и иногда жалеет об этом."
        ])

    if any(x in low for x in ("как дела", "как ты", "как жизнь", "как настроение")):
        return pick([
            "Дела норм. Я же бот, у меня нет проблем, только обновления.",
            "Стабильно. В отличие от некоторых сообщений в этом чате.",
            "Хорошо. Пока ты не начал задавать слишком много вопросов."
        ])

    # Иногда напоминаем, что запомнили
    if user.get("interests") and random.random() < 0.18:
        sample = ", ".join(user["interests"][-5:])
        return f"Я тут запомнил, что тебе интересно: {sample}. Слежка? Это называется забота."

    mode = DB.get("settings", {}).get("mode", "normal")

    # Если вопрос и режим умный или просто повезло — пробуем LLM
    if "?" in text and (mode == "smart" or random.random() < 0.35):
        llm_answer = ask_llm(text, user)
        if llm_answer:
            return llm_answer

    if mode == "troll":
        return pick(DB.get("troll", []) + DB.get("phrases", []))

    if mode == "smart":
        return pick(DB.get("smart", []) + DB.get("phrases", []))

    if mode == "chaos":
        return pick(DB.get("phrases", []) + DB.get("troll", []) + DB.get("smart", []))

    return pick(DB.get("phrases", []) + DB.get("smart", []))


