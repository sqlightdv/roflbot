def now_iso():
    return datetime.now(timezone.utc).isoformat()


def trim_list(items, limit):
    if not isinstance(items, list):
        return []
    return items[-limit:]


def user_key(chat_id, user_id):
    return f"{chat_id}:{user_id}"


def get_user(chat_id, user_id):
    key = user_key(chat_id, user_id)
    if key not in DB["users"]:
        DB["users"][key] = {
            "id": user_id,
            "chat_id": chat_id,
            "first_seen": now_iso(),
            "messages": 0,
            "name": "",
            "username": "",
            "interests": [],
            "facts": [],
            "last_messages": []
        }

    user = DB["users"][key]
    user.setdefault("id", user_id)
    user.setdefault("chat_id", chat_id)
    user.setdefault("messages", 0)
    user.setdefault("name", "")
    user.setdefault("username", "")
    user.setdefault("interests", [])
    user.setdefault("facts", [])
    user.setdefault("last_messages", [])
    return user


def touch_chat(message):
    chat = message.get("chat", {})
    chat_id = chat.get("id")
    if chat_id is None:
        return

    DB.setdefault("chats", {})[str(chat_id)] = {
        "id": chat_id,
        "title": chat.get("title") or chat.get("first_name") or "",
        "type": chat.get("type", ""),
        "updated": now_iso()
    }


INTEREST_RE = re.compile(
    r"(?:люблю|нравится|интересуюсь|интересует|играю в|играю на|слушаю|смотрю|читаю|занимаюсь|учу|изучаю|мечтаю о|хочу)\s+(.{2,80})",
    re.I | re.U
)

HASHTAG_RE = re.compile(r"#([A-Za-zА-Яа-яЁё0-9_]{2,30})", re.U)


def extract_interests(text, user):
    found = False

    match = INTEREST_RE.search(text)
    if match:
        interest = match.group(1).strip(" .,!?;:()[]{}\"'")[:80]
        if interest and interest.lower() not in [x.lower() for x in user.get("interests", [])]:
            user.setdefault("interests", []).append(interest)
            found = True

    for tag in HASHTAG_RE.findall(text):
        if tag.lower() not in [x.lower() for x in user.get("interests", [])]:
            user.setdefault("interests", []).append(tag)
            found = True

    user["interests"] = trim_list(user.get("interests", []), 40)
    return found


def remember_message(message):
    from_user = message.get("from") or {}
    if not from_user or from_user.get("is_bot"):
        return None

    chat_id = message.get("chat", {}).get("id")
    user_id = from_user.get("id")

    if chat_id is None or user_id is None:
        return None

    user = get_user(chat_id, user_id)
    user["messages"] = int(user.get("messages", 0)) + 1

    first_name = from_user.get("first_name") or ""
    last_name = from_user.get("last_name") or ""
    full_name = f"{first_name} {last_name}".strip()

    if full_name:
        user["name"] = full_name

    if from_user.get("username"):
        user["username"] = from_user["username"]

    text = message.get("text") or message.get("caption") or ""
    if text:
        user["last_messages"].append(text[:200])
        user["last_messages"] = trim_list(user["last_messages"], 30)
        extract_interests(text, user)

    touch_chat(message)
    return user


def pick(items, fallback="Я бы ответил, но у меня вышел запас рофлов."):
    if not isinstance(items, list):
        items = []
    items = [str(x) for x in items if x]
    return random.choice(items) if items else fallback


def can_random_reply(chat_id):
    now = time.time()
    last = LAST_RANDOM.get(chat_id, 0)
    if now - last < 15:
        return False
    LAST_RANDOM[chat_id] = now
    return True


