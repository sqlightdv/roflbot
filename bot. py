def handle_command(message, cmd, args):
    chat = message.get("chat", {})
    chat_id = chat.get("id")
    message_id = message.get("message_id")
    from_user = message.get("from") or {}
    user_id = from_user.get("id")

    if chat_id is None or user_id is None:
        return

    if cmd == "start":
        remember_message(message)
        save_db()
        if chat.get("type") == "private":
            send_message(
                chat_id,
                "Я рофл-бот. Иногда умный, чаще вредный. Пиши в чат или упомяни меня. /help — команды."
            )
        else:
            send_message(
                chat_id,
                "Я тут. Иногда умный, чаще вредный. /help — команды.",
                reply_to=message_id
            )
        return

    if cmd == "help":
        remember_message(message)
        save_db()
        send_message(chat_id, PUBLIC_HELP, reply_to=message_id)
        return

    if cmd == "whoami":
        user = get_user(chat_id, user_id)
        interests = ", ".join(user.get("interests", [])[-10:]) or "пока пусто"
        facts = "; ".join(user.get("facts", [])[-5:]) or "нет"
        last = user.get("last_messages", [])[-1] if user.get("last_messages") else "нет"
        username = f"@{user['username']}" if user.get("username") else "нет"

        text = (
            f"Имя: {user.get('name', '?')}\n"
            f"Юзернейм: {username}\n"
            f"Сообщений в этом чате: {user.get('messages', 0)}\n"
            f"Интересы: {interests}\n"
            f"Факты: {facts}\n"
            f"Последнее запомненное: {last}"
        )
        send_message(chat_id, text[:4000], reply_to=message_id)
        return

    if cmd == "forgetme":
        key = user_key(chat_id, user_id)
        if key in DB.get("users", {}):
            del DB["users"][key]
            save_db()
            send_message(chat_id, "Готово. В этом чате ты для меня чистый лист.", reply_to=message_id)
        else:
            send_message(chat_id, "Тут и забывать нечего.", reply_to=message_id)
        return

    if cmd == "roast":
        remember_message(message)
        save_db()
        send_message(chat_id, pick(DB.get("roasts", [])), reply_to=message_id)
        return

    if cmd == "admin":
        if not require_admin(message):
            return
        send_message(chat_id, ADMIN_HELP, reply_to=message_id)
        return

    if cmd == "stats":
        if not require_admin(message):
            return

        total_users = len(DB.get("users", {}))
        total_chats = len(DB.get("chats", {}))
        total_messages = sum(int(u.get("messages", 0)) for u in DB.get("users", {}).values())
        mode = DB.get("settings", {}).get("mode", "normal")
        chance = DB.get("settings", {}).get("reply_chance", 0.30)

        text = (
            f"Юзеров: {total_users}\n"
            f"Чатов: {total_chats}\n"
            f"Сообщений: {total_messages}\n"
            f"Триггеров: {len(DB.get('triggers', {}))}\n"
            f"Режим: {mode}\n"
            f"Шанс ответа в группах: {chance}"
        )
        send_message(chat_id, text, reply_to=message_id)
        return

    if cmd == "say":
        if not require_admin(message):
            return

        if not args.strip():
            send_message(chat_id, "Использование: /say текст", reply_to=message_id)
            return

        send_message(chat_id, args.strip())
        tg("deleteMessage", chat_id=chat_id, message_id=message_id)
        return

    if cmd == "setmode":
        if not require_admin(message):
            return

        modes = {
            "normal": 0.30,
            "troll": 0.50,
            "smart": 0.35,
            "chaos": 0.75,
            "silent": 0.0
        }

        mode = args.strip().lower()
        if mode not in modes:
            send_message(
                chat_id,
                "Режимы: normal, troll, smart, chaos, silent.\nПример: /setmode troll",
                reply_to=message_id
            )
            return

        DB["settings"]["mode"] = mode
        DB["settings"]["reply_chance"] = modes[mode]
        save_db()
        send_message(chat_id, f"Режим изменён на {mode}.", reply_to=message_id)
        return

    if cmd == "setchance":
        if not require_admin(message):
            return

        try:
            value = float(args.strip())
        except Exception:
            send_message(chat_id, "Использование: /setchance 0.35", reply_to=message_id)
            return

        if value < 0 or value > 1:
            send_message(chat_id, "Шанс должен быть от 0 до 1.", reply_to=message_id)
            return

        DB["settings"]["reply_chance"] = value
        save_db()
        send_message(chat_id, f"Шанс ответа в группах: {value}", reply_to=message_id)
        return

    if cmd == "addtrigger":
        if not require_admin(message):
            return

        if "|" not in args:
            send_message(chat_id, "Использование: /addtrigger триггер | ответ", reply_to=message_id)
            return

        trigger, response = args.split("|", 1)
        trigger = trigger.strip().lower()
        response = response.strip()

        if not trigger or not response:
            send_message(chat_id, "Триггер и ответ не должны быть пустыми.", reply_to=message_id)
            return

        if not isinstance(DB.get("triggers"), dict):
            DB["triggers"] = {}

        current = DB["triggers"].get(trigger, [])
        if isinstance(current, str):
            current = [current]

        current.append(response)
        DB["triggers"][trigger] = current
        save_db()
        send_message(chat_id, f"Триггер сохранён: {trigger}", reply_to=message_id)
        return

    if cmd == "deltrigger":
        if not require_admin(message):
            return

        trigger = args.strip().lower()
        if trigger and trigger in DB.get("triggers", {}):
            del DB["triggers"][trigger]
            save_db()
            send_message(chat_id, f"Триггер удалён: {trigger}", reply_to=message_id)
        else:
            send_message(chat_id, "Такого триггера нет.", reply_to=message_id)
        return

    if cmd == "triggers":
        if not require_admin(message):
            return

        keys = list(DB.get("triggers", {}).keys())
        if not keys:
            send_message(chat_id, "Триггеров пока нет.", reply_to=message_id)
        else:
            text = "Триггеры:\n" + "\n".join(keys[:200])
            send_message(chat_id, text[:4000], reply_to=message_id)
        return

    if cmd == "addtroll":
        if not require_admin(message):
            return

        if add_phrase_to_db(args, "troll"):
            send_message(chat_id, "Добавил в тролль-фразы.", reply_to=message_id)
        else:
            send_message(chat_id, "Использование: /addtroll текст", reply_to=message_id)
        return

    if cmd == "addsmart":
        if not require_admin(message):
            return

        if add_phrase_to_db(args, "smart"):
            send_message(chat_id, "Добавил в умные фразы.", reply_to=message_id)
        else:
            send_message(chat_id, "Использование: /addsmart текст", reply_to=message_id)
        return

    if cmd == "addphrase":
        if not require_admin(message):
            return

        if add_phrase_to_db(args, "phrases"):
            send_message(chat_id, "Добавил в обычные фразы.", reply_to=message_id)
        else:
            send_message(chat_id, "Использование: /addphrase текст", reply_to=message_id)
        return

    if cmd == "info":
        if not require_admin(message):
            return

        target_id = None
        reply_message = message.get("reply_to_message") or {}
        reply_from = reply_message.get("from") or {}

        if reply_from.get("id"):
            target_id = reply_from.get("id")
        else:
            parts = args.split()
            if parts and parts[0].isdigit():
                target_id = int(parts[0])

        if not target_id:
            send_message(chat_id, "Ответь на сообщение пользователя или укажи ID: /info 123456", reply_to=message_id)
            return

        suffix = f":{target_id}"
        records = [(k, v) for k, v in DB.get("users", {}).items() if k.endswith(suffix)]

        if not records:
            send_message(chat_id, "Ничего не помню про этого пользователя.", reply_to=message_id)
            return

        total_messages = sum(int(v.get("messages", 0)) for _, v in records)
        interests = set()
        facts = set()
        chats = set()
        name = "?"
        username = ""

        for _, record in records:
            if record.get("name"):
                name = record["name"]
            if record.get("username"):
                username = record["username"]
            interests.update(record.get("interests", []))
            facts.update(record.get("facts", []))
            if record.get("chat_id") is not None:
                chats.add(str(record["chat_id"]))

        interests_text = ", ".join(list(interests)[-15:]) or "нет"
        facts_text = "; ".join(list(facts)[-10:]) or "нет"
        username_text = f"@{username}" if username else "нет"

        text = (
            f"ID: {target_id}\n"
            f"Имя: {name}\n"
            f"Юзернейм: {username_text}\n"
            f"Сообщений всего: {total_messages}\n"
            f"Чатов: {', '.join(sorted(chats)) or '?'}\n"
            f"Интересы: {interests_text}\n"
            f"Факты: {facts_text}"
        )
        send_message(chat_id, text[:4000], reply_to=message_id)
        return

    if cmd == "remember":
        if not require_admin(message):
            return

        fact = args.strip()
        if not fact:
            send_message(
                chat_id,
                "Использование: /remember текст (можно реплаем на пользователя)",
                reply_to=message_id
            )
            return

        reply_message = message.get("reply_to_message") or {}
        reply_from = reply_message.get("from") or {}
        target_id = reply_from.get("id") or user_id

        user = get_user(chat_id, target_id)
        user["facts"].append(fact[:200])
        user["facts"] = trim_list(user["facts"], 50)
        save_db()

        send_message(chat_id, "Запомнил факт.", reply_to=message_id)
        return

    if chat.get("type") == "private":
        send_message(
            chat_id,
            pick([
                "Неизвестная команда. Но я запомнил, что ты пытаешься.",
                "Такой команды нет. Попробуй /help."
            ]),
            reply_to=message_id
        )


